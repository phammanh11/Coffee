{
  "name": "moc-coffee",
  "private": true,
  "version": "1.0.0",
  "description": "MỘC Coffee — Hương Vị Việt. Đánh Thức Đam Mê. Full-stack E-Commerce trên Cloudflare Pages/Workers, HonoJS, D1, R2 và ReactJS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev dist",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute moc-coffee-db --local --file=./backend/migrations/0001_schema.sql",
    "db:migrate:prod": "wrangler d1 execute moc-coffee-db --remote --file=./backend/migrations/0001_schema.sql",
    "db:seed": "wrangler d1 execute moc-coffee-db --local --file=./backend/seeds/seed.sql",
    "deploy:api": "npm run build && wrangler pages deploy dist",
    "deploy:web": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.0",
    "@tanstack/react-query": "^5.66.0",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.0"
  }
}

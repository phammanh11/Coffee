{
  // Cấu hình chuẩn cho Cloudflare Pages (coffeet1.pages.dev)
  "name": "coffeet1",
  "compatibility_date": "2025-02-14",
  "pages_build_output_dir": "./dist",
  "vars": {
    "ENVIRONMENT": "development",
    "DEFAULT_SHIPPING_FEE": "30000",
    "FREE_SHIPPING_THRESHOLD": "500000"
  }
  // Khi bạn đã tạo D1 Database & R2 Bucket trong Cloudflare Dashboard:
  // Bạn có thể gắn trực tiếp trong mục:
  // Workers & Pages -> coffeet1 -> Settings -> Bindings -> Add D1 database (Biến: DB) & R2 bucket (Biến: BUCKET)
}
